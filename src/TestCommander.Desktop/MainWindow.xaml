<Window x:Class="TestCommander.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TestCommander" Height="850" Width="1440" MinHeight="650" MinWidth="1000" Background="#101720" Foreground="#E8EDF2" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="#263440"/><Setter Property="Foreground" Value="#E8EDF2"/><Setter Property="BorderBrush" Value="#3B4A57"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#111B24"/><Setter Property="Foreground" Value="#E8EDF2"/><Setter Property="BorderBrush" Value="#3B4A57"/><Setter Property="Padding" Value="10,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="#18232E"/><Setter Property="Foreground" Value="#E8EDF2"/><Setter Property="BorderBrush" Value="#33414D"/><Setter Property="RowBackground" Value="#18232E"/><Setter Property="AlternatingRowBackground" Value="#1D2A36"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#131D27" BorderBrush="#293743" BorderThickness="0,0,1,0">
      <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="TESTCOMMANDER" FontSize="18" FontWeight="Bold" Foreground="#D6A65F" Margin="2,8,0,4"/>
          <TextBlock Text="TRAVIAN COMPANION" FontSize="10" Foreground="#81909D" Margin="2,0,0,30"/>
          <TextBlock Text="WORKSPACE" Foreground="#81909D" FontSize="10" Margin="2,0,0,10"/>
          <TextBlock Text="●  Browser" FontSize="14" Margin="2,7"/>
          <TextBlock Text="◈  Village monitor" FontSize="14" Margin="2,7"/>
          <TextBlock Text="▤  Activity log" FontSize="14" Margin="2,7"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="READ-ONLY COMPANION" Foreground="#D6A65F" FontSize="10" FontWeight="SemiBold"/>
          <TextBlock Text="Passive observation only. Actions stay in your hands." TextWrapping="Wrap" Foreground="#81909D" FontSize="11" Margin="0,8,0,0"/>
          <TextBlock Text="LOCAL DATA • APPDATA" Foreground="#637381" FontSize="9" Margin="0,20,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,14">
        <StackPanel DockPanel.Dock="Left"><TextBlock Text="GAME SESSION" Foreground="#D6A65F" FontSize="10"/><TextBlock Text="Browser &amp; live overview" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#A9B7C2" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
      </DockPanel>
      <DockPanel Grid.Row="1" Margin="0,0,0,12">
        <Button Content="Go" DockPanel.Dock="Right" Width="70" Click="Navigate_Click"/>
        <Button Content="↻" DockPanel.Dock="Right" Width="42" Click="Refresh_Click"/>
        <TextBox x:Name="AddressBox" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="4" KeyDown="AddressBox_KeyDown"/>
      </DockPanel>
      <Border Grid.Row="2" Background="#18232E" BorderBrush="#33414D" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
        <Grid><wv2:WebView2 x:Name="Browser" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"/></Grid>
      </Border>
      <Grid Grid.Row="3" Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#18232E" BorderBrush="#33414D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,6,0">
          <StackPanel>
            <TextBlock Text="VILLAGE SNAPSHOTS" Foreground="#D6A65F" FontWeight="SemiBold" FontSize="11"/>
            <TextBlock Text="{Binding ResourceSummary}" Margin="0,8,0,5" Foreground="#A9B7C2"/>
            <ItemsControl ItemsSource="{Binding Villages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,3,0,5">
                    <TextBlock Text="{Binding VillageName}" Foreground="#E8EDF2" FontWeight="SemiBold"/>
                    <WrapPanel>
                      <TextBlock Text="{Binding Wood, StringFormat='Wood: {0}'}" Foreground="#A9B7C2" Margin="0,2,9,0"/>
                      <TextBlock Text="{Binding Clay, StringFormat='Clay: {0}'}" Foreground="#A9B7C2" Margin="0,2,9,0"/>
                      <TextBlock Text="{Binding Iron, StringFormat='Iron: {0}'}" Foreground="#A9B7C2" Margin="0,2,9,0"/>
                      <TextBlock Text="{Binding Crop, StringFormat='Crop: {0}'}" Foreground="#A9B7C2" Margin="0,2,0,0"/>
                    </WrapPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="#18232E" BorderBrush="#33414D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="6,0,0,0">
          <DockPanel><TextBlock DockPanel.Dock="Top" Text="RECENT OBSERVED RESPONSES" Foreground="#D6A65F" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,7"/><DataGrid ItemsSource="{Binding RecentResponses}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Path" Binding="{Binding UrlPath}" Width="2*"/><DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="55"/><DataGridTextColumn Header="Bytes" Binding="{Binding BodyBytes}" Width="65"/><DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="2*"/></DataGrid.Columns></DataGrid></DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>